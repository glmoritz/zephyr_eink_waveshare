# LLSS Client application configuration
# Kconfig for apps/hello_eink

menu "LLSS Client"

config LLSS_SERVER_URL
	string "LLSS server base URL"
	default "https://eink.tutu.eng.br:9608/api"
	help
	  Base URL of the Low Level Screen Service API, without trailing slash.

config LLSS_FIRMWARE_VERSION
	string "Firmware version reported to LLSS server"
	default "0.1.0"

config LLSS_AP_SSID_PREFIX
	string "WiFi AP SSID prefix for provisioning mode"
	default "LLSS-"

config LLSS_POLL_INTERVAL_MS
	int "Default poll interval in milliseconds"
	default 5000
	range 1000 60000

config LLSS_MIN_POLL_MS
	int "Minimum poll interval in milliseconds"
	default 1000

config LLSS_MAX_POLL_MS
	int "Maximum poll interval in milliseconds"
	default 60000

config LLSS_DISPLAY_BIT_DEPTH
	int "Display bit depth reported to server (8 = PNG)"
	default 8
	help
	  Bit depth registered with LLSS. A value >4 causes the server to
	  return PNG frames instead of raw packed buffers. PNG is decoded
	  on device via LVGL's lodepng integration.

config LLSS_DISPLAY_USE_CUSTOM_FULL_LUT
	bool "Use custom full-refresh SSD16xx LUT"
	default y
	help
	  Keep the custom 4-gray full-refresh waveform LUT for the hardware
	  SSD16xx panel driver. Disable this to use the controller's integrated
	  OTP full-refresh waveform instead.

config LLSS_TOP_STRIP_HEIGHT
	int "Top button-label strip height (px) reported to server"
	default 64
	help
	  Pixels reserved at the top of the display for the button-label strip.
	  Declared to LLSS at registration so the server renders the top strip
	  into that band. Should match the device UI top band (HDR_H).
	  0 = no top strip.

config LLSS_BOTTOM_STRIP_HEIGHT
	int "Bottom button-label strip height (px) reported to server"
	default 72
	help
	  Pixels reserved at the bottom of the display for the button-label strip.
	  Declared to LLSS at registration so the server renders the bottom strip
	  into that band. Should match the device UI bottom band (FTR_H).
	  0 = no bottom strip.

config LLSS_TLS_TAG
	int "TLS credential sec_tag for LLSS server CA certificate"
	default 1

config LLSS_DNS_TIMEOUT_MS
	int "DNS resolution timeout in milliseconds"
	default 5000

config LLSS_NTP_SERVER
	string "NTP server hostname"
	default "pool.ntp.org"

config LLSS_NTP_SYNC_INTERVAL_S
	int "NTP sync interval in seconds"
	default 3600

config LLSS_HTTP_TIMEOUT_MS
	int "HTTP request timeout in milliseconds"
	default 15000

config LLSS_HTTP_RECV_SCRATCH_SIZE
	int "HTTP response scratch buffer size in bytes"
	default 65535
	help
	  Size of the temporary HTTP parser scratch buffer used by llss_client.
	  This does not need to hold the full frame body; it only needs enough
	  space for response headers plus streamed body fragments. Keep this
	  modest on ESP32-S3 to avoid burning tens of kilobytes of static RAM.
	  64 KB is a performance-oriented setting for the 48 KB raw LLSS frame
	  path, allowing the client to drain the full response without a parser
	  scratch cap.

config LLSS_HTTP_SOCKET_RCVBUF_SIZE
	int "LLSS TLS socket receive buffer size in bytes"
	default 65535
	range 1024 65535
	help
	  Requested SO_RCVBUF value for the LLSS TLS socket. In Zephyr this
	  determines the TCP receive window when NET_CONTEXT_RCVBUF is enabled.
	  Keep this aligned with the HTTP scratch buffer so the client can drain
	  each advertised window in a single recv call.

config LLSS_FRAME_BUF_SIZE
	int "Maximum frame buffer size in bytes (PNG)"
	default 524288
	help
	  Maximum size of a PNG frame received from the server.
	  800x480 8bpp PNG typically compresses to 30-150 KB.
	  Allocated from SPIRAM.

config LLSS_DEVICE_ID_MAX
	int "Maximum device_id length (including NUL terminator)"
	default 65

config LLSS_DEVICE_SECRET_MAX
	int "Maximum device_secret length (including NUL terminator)"
	default 65

config LLSS_TOKEN_MAX
	int "Maximum token length (including NUL terminator)"
	default 512
	help
	  Maximum size for refresh_token and access_token buffers.

config LLSS_MAX_HOSTNAME
	int "Maximum server hostname length"
	default 64

config LLSS_MAX_BASE_PATH
	int "Maximum server base path length"
	default 64

config LLSS_MAX_URL_LEN
	int "Maximum constructed URL length"
	default 256

config LLSS_PATTERN_TEST
	bool "Deterministic frame pattern self-test (temporary debug)"
	default n
	help
	  Request a synthetic 1bpp pattern from the server (?raw=true&pattern=1)
	  instead of real frame content, and verify it byte-for-byte at each
	  pipeline stage (CP1 fetch, CP2 render) plus triple-buffer slack
	  canaries. The pattern is also visually structured so geometry errors
	  are obvious on the SDL/native_sim display. Temporary debugging aid;
	  keep disabled for normal operation.

config LLSS_NETMEM_DEBUG
	bool "Periodic network/heap resource telemetry (temporary debug)"
	default n
	help
	  Spawn a low-priority thread that periodically prints a single greppable
	  "NETMEM" line over the console: net_pkt RX/TX slab free, net_buf RX/TX
	  data pool avail/max, and (on ESP32) the IDF internal + PSRAM heap free.
	  Used to chase the slow net-buffer/heap leak that panics the device after
	  hours (esp32_wifi "unable to allocate net buffer"). Requires
	  CONFIG_NET_BUF_POOL_USAGE=y for the avail counters. Debug aid; keep
	  disabled for normal operation.

config LLSS_NETMEM_DEBUG_INTERVAL_MS
	int "NETMEM telemetry print interval in milliseconds"
	default 30000
	depends on LLSS_NETMEM_DEBUG

config LLSS_WATCHDOG
	bool "Connectivity watchdog (server-reachability self-heal escalation)"
	default y
	help
	  Escalating self-heal when the device cannot reach the server while Wi-Fi
	  is up: soft reset (session + DNS reinit) on an exponential backoff, then
	  reboot as a last resort. Counters persist in RTC RAM across the reboot.
	  Does NOT include the Task-WDT/hardware-WDT per-thread liveness layer yet.

config LLSS_WATCHDOG_DRY_RUN
	bool "Watchdog dry-run (log 'would reset now' instead of rebooting)"
	default y
	depends on LLSS_WATCHDOG
	help
	  While debugging, the reboot step only logs "WATCHDOG: would reset now ..."
	  and advances its backoff schedule instead of calling sys_reboot(), so the
	  escalation is observable without disrupting a capture. Set =n to arm real
	  reboots.

config LLSS_WATCHDOG_SOFT_RESET_BASE_S
	int "Watchdog: first soft reset after this many seconds offline"
	default 60
	depends on LLSS_WATCHDOG

config LLSS_WATCHDOG_SOFT_RESET_MAX_S
	int "Watchdog: max interval between soft resets (exponential cap), seconds"
	default 600
	depends on LLSS_WATCHDOG

config LLSS_WATCHDOG_REBOOT_BASE_S
	int "Watchdog: first reboot after this many seconds offline"
	default 300
	depends on LLSS_WATCHDOG

config LLSS_WATCHDOG_MAX_PERIOD_S
	int "Watchdog: max reboot backoff period (exponential cap), seconds"
	default 86400
	depends on LLSS_WATCHDOG

config LLSS_HW_WATCHDOG
	bool "System liveness watchdog (supervisor thread + hardware WDT)"
	default n
	select WATCHDOG if !LLSS_HW_WATCHDOG_DRY_RUN
	select WDT_ESP32 if (!LLSS_HW_WATCHDOG_DRY_RUN && SOC_FAMILY_ESPRESSIF_ESP32)
	help
	  A supervisor thread watches registered threads via sys_watchdog.h. Each
	  thread marks itself alive while working and idle before an intentional
	  blocking sleep (idle threads are ignored). A thread that stays active past
	  its timeout is deemed hung. When armed (dry-run off) the supervisor feeds
	  the ESP32 hardware WDT while healthy, so a hung thread or a hung supervisor
	  triggers a hardware reset.

	  Leave OFF while debugging: a hardware reset would erase a halted panic
	  before it can be captured.

config LLSS_HW_WATCHDOG_DRY_RUN
	bool "Liveness watchdog dry-run (log 'would reset', no reboot, no HW WDT)"
	default y
	depends on LLSS_HW_WATCHDOG
	help
	  Supervisor logs "WATCHDOG: would reset now — '<thread>' starved" and keeps
	  running instead of resetting, and the hardware WDT is not armed. Lets the
	  liveness logic be observed without disrupting a capture. Set =n to arm
	  real hardware-backed resets for production.

config LLSS_HW_WATCHDOG_CHECK_MS
	int "Liveness watchdog supervisor check interval (ms)"
	default 5000
	depends on LLSS_HW_WATCHDOG

config LLSS_HW_WATCHDOG_HW_TIMEOUT_MS
	int "Hardware WDT timeout (ms) when armed"
	default 16000
	depends on LLSS_HW_WATCHDOG
	help
	  Must exceed the supervisor check interval comfortably so a healthy
	  supervisor always feeds the HW WDT in time; if the supervisor itself hangs,
	  the HW WDT fires after this period.

endmenu

source "Kconfig.zephyr"
